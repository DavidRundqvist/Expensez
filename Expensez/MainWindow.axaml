<Window
    x:Class="Expensez.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="clr-namespace:Expensez"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="local:MainPresentation"
    xmlns:local="clr-namespace:Expensez"    
    Title="Expensez"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <TabControl x:Name="_mainTab">

        <TabItem Header="Categorization" IsSelected="True">
            <e:Categorization DataContext="{Binding Categorization}"/>
        </TabItem>

        <TabItem Header="Results" IsSelected="False" />
    </TabControl>
</Window>
